<Project>
  <Import Project="Sdk.props" Sdk="WixToolset.Sdk" Version="7.0.0" />
  <ItemGroup>
    <PackageReference Include="WixToolset.Netfx.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XenAdmin\XenAdmin.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputName>XCP-ng Center</OutputName>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>
  <Import Project="Sdk.targets" Sdk="WixToolset.Sdk" Version="7.0.0" />
  <Target Name="BeforeBuild">
    <GetAssemblyIdentity AssemblyFiles="$(MSBuildThisFileDirectory)..\XenAdmin\bin\$(Configuration)\net481\XCP-ng Center.exe">
      <Output TaskParameter="Assemblies" ItemName="AssemblyVersions" />
    </GetAssemblyIdentity>
    <!-- Create the WiX preprocessor variable $(var.VersionNumber) -->
    <PropertyGroup>
      <VersionNumber>%(AssemblyVersions.Version)</VersionNumber>
      <DefineConstants>VersionNumber=$(VersionNumber)</DefineConstants>
    </PropertyGroup>
    <CreateProperty Value="$(OutputName)-$(VersionNumber)-$(Platform)">
      <Output TaskParameter="Value" PropertyName="TargetName" />
    </CreateProperty>
    <CreateProperty Value="$(TargetName)$(TargetExt)">
      <Output TaskParameter="Value" PropertyName="TargetFileName" />
    </CreateProperty>
    <CreateProperty Value="$(TargetDir)$(TargetFileName)">
      <Output TaskParameter="Value" PropertyName="TargetPath" />
    </CreateProperty>
  </Target>
</Project>